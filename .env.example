# ============================
# Portfolio Environment Config
# ============================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ----- Contact Email -----
# The email address where contact form submissions are sent
CONTACT_EMAIL=maddulapurushottama@gmail.com

# ----- Email Service (Resend - recommended) -----
# Sign up at https://resend.com and create an API key.
# Free tier: 100 emails/day, 3,000 emails/month.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ----- Site Metadata -----
NEXT_PUBLIC_SITE_NAME=Maddula's Portfolio
